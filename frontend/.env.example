# URL of the FastAPI backend, no trailing slash.
#
# Local dev (backend run with `uvicorn main:app --reload` on its default
# port): leave this as-is.
VITE_API_URL=http://localhost:8000

# Production: the actual deployed backend for this project is on Render.
# When building/deploying the frontend (Vercel/Netlify), set VITE_API_URL
# as a BUILD-TIME environment variable on that platform to:
#   VITE_API_URL=https://ai-hallucination-detector-1.onrender.com
# Vite inlines VITE_* vars at build time, so this must be set before
# `npm run build` runs on the deploy platform -- setting it only at
# runtime (e.g. in a shell) has no effect on an already-built app.
#
# Also make sure the backend's ALLOWED_ORIGINS env var (on Render) includes
# this frontend's deployed origin, or the browser will block the request
# via CORS even though the URL above is correct. See ../README.md.
